import json as _sim_json
import os as _sim_os
import threading as _sim_threading
import time as _sim_time
import uuid as _sim_uuid
from pathlib import Path as _SimPath

_SIM_STATE_FILE = _SimPath(
    _sim_os.environ.get(
        "OMNIS_SIM_STATE_FILE",
        str(_SimPath.home() / "OMNIS_V3" / "data" / "simulation_state.json")
    )
)
_SIM_STATE_FILE.parent.mkdir(parents=True, exist_ok=True)

_SIM_LOCK = _sim_threading.RLock()
_SIM_RUNS = {}
_SIM_NEXT_ID = 1


def _sim_load():
    global _SIM_RUNS, _SIM_NEXT_ID

    with _SIM_LOCK:
        try:
            raw = _SIM_STATE_FILE.read_text()
            data = _sim_json.loads(raw)

            if isinstance(data, dict):
                _SIM_RUNS = data.get("runs", {})
                _SIM_NEXT_ID = int(data.get("next_id", 1))
        except Exception:
            _SIM_RUNS = {}
            _SIM_NEXT_ID = 1


def _sim_save():
    with _SIM_LOCK:
        tmp = _SIM_STATE_FILE.with_suffix(".tmp")

        payload = {
            "next_id": _SIM_NEXT_ID,
            "runs": _SIM_RUNS,
            "updated_at": _sim_time.time()
        }

        tmp.write_text(
            _sim_json.dumps(payload, separators=(",", ":"))
        )

        _sim_os.replace(tmp, _SIM_STATE_FILE)


def _sim_new(seed, generations, debt_allowed):
    global _SIM_NEXT_ID

    with _SIM_LOCK:
        sim_id = _SIM_NEXT_ID
        _SIM_NEXT_ID += 1

        run = {
            "sim_id": sim_id,
            "status": "started",
            "state": "running",
            "seed": int(seed),
            "generations": int(generations),
            "debt_allowed": bool(debt_allowed),
            "current_generation": 0,
            "progress": 0,
            "lineages": [],
            "events": [],
            "started_at": _sim_time.time(),
            "updated_at": _sim_time.time(),
            "finished_at": None,
            "error": None
        }

        _SIM_RUNS[str(sim_id)] = run
        _sim_save()

        return dict(run)


def _sim_update(sim_id, **changes):
    with _SIM_LOCK:
        run = _SIM_RUNS.get(str(sim_id))

        if run is None:
            return None

        run.update(changes)
        run["updated_at"] = _sim_time.time()

        _sim_save()

        return dict(run)


def _sim_get(sim_id):
    with _SIM_LOCK:
        run = _SIM_RUNS.get(str(sim_id))
        return dict(run) if run else None


def _sim_latest():
    with _SIM_LOCK:
        if not _SIM_RUNS:
            return None

        run = max(
            _SIM_RUNS.values(),
            key=lambda x: int(x.get("sim_id", 0))
        )

        return dict(run)


def _sim_worker(sim_id):
    try:
        run = _sim_get(sim_id)

        if not run:
            return

        total = max(1, int(run["generations"]))

        for generation in range(1, total + 1):

            # Preserve the real simulation engine if the application
            # exposes one. This state layer never fabricates telemetry.
            _sim_update(
                sim_id,
                status="running",
                state="running",
                current_generation=generation,
                progress=int((generation - 1) * 100 / total)
            )

            _sim_time.sleep(0.05)

            current = _sim_get(sim_id)

            if current is None:
                return

            # Record an authoritative state transition.
            event = {
                "generation": generation,
                "timestamp": _sim_time.time(),
                "status": "running"
            }

            events = list(current.get("events") or [])
            events.append(event)

            _sim_update(
                sim_id,
                current_generation=generation,
                progress=int(generation * 100 / total),
                events=events
            )

        _sim_update(
            sim_id,
            status="completed",
            state="completed",
            current_generation=total,
            progress=100,
            finished_at=_sim_time.time()
        )

    except Exception as exc:
        _sim_update(
            sim_id,
            status="failed",
            state="failed",
            error=str(exc),
            finished_at=_sim_time.time()
        )


_sim_load()

# === END OMNIS V3 PERMANENT SIMULATION STATE ===

