@app.post("/api/sim/start")
def omnis_v3_start_sim(payload: dict = None):
    payload = payload or {}

    seed = payload.get("seed", 42)
    generations = payload.get("generations", 10)
    debt_allowed = payload.get("debt_allowed", True)

    if not isinstance(seed, int) or seed < 0 or seed > 2147483647:
        raise HTTPException(
            status_code=400,
            detail="seed must be an integer from 0 to 2147483647"
        )

    if not isinstance(generations, int) or generations < 1 or generations > 50:
        raise HTTPException(
            status_code=400,
            detail="generations must be an integer from 1 to 50"
        )

    run = _sim_new(seed, generations, debt_allowed)

    thread = _sim_threading.Thread(
        target=_sim_worker,
        args=(run["sim_id"],),
        daemon=True
    )
    thread.start()

    return {
        "status": "started",
        "sim_id": run["sim_id"],
        "seed": run["seed"],
        "generations": run["generations"]
    }


@app.get("/api/sim/status/{sim_id}")
def omnis_v3_sim_status(sim_id: int):
    run = _sim_get(sim_id)

    if run is None:
        raise HTTPException(
            status_code=404,
            detail=f"simulation {sim_id} not found"
        )

    return run


@app.get("/api/sim/latest")
def omnis_v3_sim_latest():
    run = _sim_latest()

    if run is None:
        return {
            "lineages": [],
            "simulation": None
        }

    return {
        "lineages": run.get("lineages", []),
        "simulation": run
    }


@app.get("/api/sim/stats")
def omnis_v3_sim_stats():
    with _SIM_LOCK:
        return list(_SIM_RUNS.values())


